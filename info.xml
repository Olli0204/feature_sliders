<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Merkmal-Bereichsfilter</Name>
    <Description>Darstellung der Merkmalfilter je Merkmal einstellbar: Schieberegler für Bereiche (z. B. Körpergewicht „35 - 55 kg“) oder Einzelwerte (z. B. Länge „154 cm“) und Werte als Boxen statt Checkliste; Filtergruppen legen je Kategorie fest, welche Merkmale erscheinen.</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.7.0</MinShopVersion>
    <MaxShopVersion>5.8.1</MaxShopVersion>
    <PluginID>feature_sliders</PluginID>
    <Version>1.5.0</Version>
    <CreateDate>2026-09-24</CreateDate>
    <Install>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Merkmale</Name>
            </Customlink>
            <Customlink sort="2">
                <Name>Filtergruppen</Name>
            </Customlink>
            <Settingslink sort="3">
                <Name>Einstellungen</Name>
                <Setting type="checkbox" initialValue="on" sort="1" conf="Y">
                    <Name>Filter aktiv</Name>
                    <Description>Schaltet alle Schieberegler im Shop ein. Welches Merkmal wie dargestellt wird, legen Sie im Tab „Merkmale“ fest.</Description>
                    <ValueName>mrf_active</ValueName>
                </Setting>
                <Setting type="text" initialValue="mrf" sort="2" conf="Y">
                    <Name>URL-Parameter-Präfix</Name>
                    <Description>Präfix der Filter-Parameter in der URL, gefolgt von der Merkmal-ID (z. B. „mrf12=40_60“). Nur Kleinbuchstaben und Unterstrich.</Description>
                    <ValueName>mrf_url_param</ValueName>
                </Setting>
            </Settingslink>
        </Adminmenu>
        <Boxes>
            <Box>
                <Name>Merkmal-Bereichsfilter (veraltet, kann gelöscht werden)</Name>
                <Available>2</Available>
                <TemplateFile>range_filter.tpl</TemplateFile>
            </Box>
        </Boxes>
        <Locales>
            <Variable>
                <Name>mrf_from</Name>
                <Description>Beschriftung des linken Eingabefelds</Description>
                <VariableLocalized iso="GER">Von</VariableLocalized>
                <VariableLocalized iso="ENG">From</VariableLocalized>
            </Variable>
            <Variable>
                <Name>mrf_to</Name>
                <Description>Beschriftung des rechten Eingabefelds</Description>
                <VariableLocalized iso="GER">Bis</VariableLocalized>
                <VariableLocalized iso="ENG">To</VariableLocalized>
            </Variable>
        </Locales>
    </Install>
</jtlshopplugin>
